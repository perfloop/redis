+#ifdef PERFLOOP_PARSE_TRACE
+#define PERFLOOP_PARSE_TRACE_CAPACITY (1U << 20)
+
+static uint64_t *perfloop_parse_trace;
+static size_t perfloop_parse_trace_count;
+
+static uint64_t perfloopParseTurnNowNs(void) {
+    struct timespec ts;
+    clock_gettime(CLOCK_MONOTONIC, &ts);
+    return (uint64_t)ts.tv_sec * 1000000000ULL + (uint64_t)ts.tv_nsec;
+}
+
+static void perfloopTraceParseTurn(uint64_t elapsed_ns) {
+    if (!perfloop_parse_trace) {
+        const char *path = getenv("PERFLOOP_PARSE_TRACE");
+        if (!path) return;
+        int fd = open(path, O_RDWR | O_CREAT | O_TRUNC, 0600);
+        if (fd == -1) return;
+        size_t bytes = PERFLOOP_PARSE_TRACE_CAPACITY * sizeof(*perfloop_parse_trace);
+        if (ftruncate(fd, bytes) == -1) {
+            close(fd);
+            return;
+        }
+        perfloop_parse_trace = mmap(NULL, bytes, PROT_READ | PROT_WRITE, MAP_SHARED, fd, 0);
+        close(fd);
+        if (perfloop_parse_trace == MAP_FAILED) perfloop_parse_trace = NULL;
+    }
+    if (perfloop_parse_trace && perfloop_parse_trace_count < PERFLOOP_PARSE_TRACE_CAPACITY)
+        perfloop_parse_trace[perfloop_parse_trace_count++] = elapsed_ns;
+}
+#endif
